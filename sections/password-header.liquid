<div class="password-content">
  {% if section.settings.logo %}
    <a href="{{ routes.root_url }}" itemprop="url" class="site-header__logo-image">
      {% capture logo_alt %}{{ section.settings.logo.alt | default: shop.name }}{% endcapture %}
      <img
        src="{{ section.settings.logo | image_url: width: 600 }}"
        alt="{{ logo_alt | escape }}"
        loading="lazy"
        width="{{ section.settings.logo.width }}"
        height="{{ section.settings.logo.height }}"
        style="max-width: {{ section.settings.logo_max_width }}px;">
    </a>
  {% else %}
    <h1 class="site-header__logo-link">
      <span class="logo">{{ shop.name }}</span>
    </h1>
  {% endif %}
  <span class="h2 password-content__title">{{ section.settings.header | escape }}</span>
</div>

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_max_width",
        "label": "Custom logo width",
        "min": 50,
        "max": 500,
        "step": 10,
        "unit": "px",
        "default": 100
      },
      {
        "type": "text",
        "id": "header",
        "label": "Heading",
        "default": "Coming Soon"
      }
    ]
  }
  {% endschema %}  